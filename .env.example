# Optional: scoreboard-auth base URL (https://github.com/k3ckinator/scoreboard-auth), no trailing slash.
# AUTH_API_URL=http://localhost:4000

# Optional: protect /control and logo upload when set (overlay stays public). Ignored if AUTH_API_URL is set.
CONTROL_ACCESS_PASSWORD=

# Recommended in production when CONTROL_ACCESS_PASSWORD is set (long random string).
CONTROL_AUTH_SECRET=

PORT=3000
HOSTNAME=0.0.0.0
